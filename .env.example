# Groq API — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Optional key pool for automatic rotation/failover (comma-separated)
# Example: GROQ_API_KEYS=key1,key2
GROQ_API_KEYS=

# X feed ingestion via Nitter RSS (no API key required)
# Optional override: comma-separated mirrors, defaults are built-in
NITTER_RSS_BASES=https://nitter.net,https://nitter.poast.org,https://nitter.privacydev.net

# Telegram API — https://my.telegram.org
# Free — create an app to get these
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=your_phone_number_here

# Tavily search — https://tavily.com
# Free tier: 1000 searches/month
TAVILY_API_KEY=your_tavily_api_key_here

# Redis URL — set by Railway/Fly automatically, override for local dev
REDIS_URL=redis://localhost:6379

# Environment
ENV=development  # development | production

# Budget controls (free-tier safe defaults)
DEFAULT_MODE=light  # full | light | minimal
LLM_SAVER_PROFILE=strict  # strict | saver | balanced
OVERLIMIT_POLICY=degrade_background
TOKEN_ESTIMATE_MARGIN=0.15
BACKGROUND_LLM_MIN_INTERVAL_SEC=0
BACKGROUND_PACE_SAFETY_FACTOR=1.25
BACKGROUND_PROMPT_CHAR_LIMIT_FAST=900
BACKGROUND_PROMPT_CHAR_LIMIT_STANDARD=1600
BACKGROUND_PROMPT_CHAR_LIMIT_DEEP=2200
BACKGROUND_MAX_TOKENS_FAST=100
BACKGROUND_MAX_TOKENS_STANDARD=180
BACKGROUND_MAX_TOKENS_DEEP=260
OBSERVATORY_THROTTLE_SECONDS=120
BUDGET_SKIP_KEY_PREFIX=budget_skip
BUDGET_SKIP_RETENTION_MINUTES=180
MAX_RSS_ITEMS_PER_SOURCE=3
MAX_X_ITEMS_PER_ACCOUNT=3
MAX_TG_MESSAGES_PER_CHANNEL=2
MAX_X_ACCOUNTS_PER_POLL_LIGHT=2
MAX_TG_CHANNELS_PER_POLL_LIGHT=2
MONITOR_TICK_SEC=60
MONITOR_TICK_JITTER_SEC=10
MAX_RSS_SOURCES_PER_TICK_FULL=2
MAX_RSS_SOURCES_PER_TICK_LIGHT=1
MAX_RSS_SOURCES_PER_TICK_MINIMAL=1
MAX_X_SOURCES_PER_TICK_FULL=1
MAX_X_SOURCES_PER_TICK_LIGHT=1
MAX_TG_SOURCES_PER_TICK_FULL=1
MAX_TG_SOURCES_PER_TICK_LIGHT=1
MONITOR_MAX_SOURCE_DELAY_SEC=600
ORCH_LIGHT_MODE_THRESHOLD=0.7
ORCH_MINIMAL_MODE_THRESHOLD=0.92
RESEARCHER_STREAM_ANALYSIS_MIN_INTERVAL_SEC=180
RESEARCHER_POST_IDLE_BACKSTOP_HOURS=18
RESEARCHER_POST_IDLE_FORCE_COOLDOWN_SEC=21600
RESEARCHER_THEORY_IDLE_BACKSTOP_HOURS=48
SOCIAL_RELEVANCE_KEYWORDS=iran,tehran,israel,idf,irgc,hezbollah,houthi,hamas,gaza,nuclear,iaea,centcom,strait of hormuz,persian gulf,sanctions
TELEGRAM_RETRY_COOLDOWN_SEC=3600
SOURCE_MONITOR_STARTUP_JITTER_SEC=60
SOURCE_MONITOR_CHECK_INTERVAL_SEC=21600
BUDGET_SKIP_WINDOW_MINUTES=60
CONTEXT_DISCOVERY_INTERVAL_SEC=1200
CONTEXT_MAX_STALENESS_SEC=21600
CONTEXT_STARTUP_JITTER_SEC=30
CONTEXT_STRUCTURAL_REFRESH_SEC=86400
CONTEXT_MAX_STREAM_DELTAS_IN_SNAPSHOT=12
CONTEXT_MAX_STREAM_DELTAS_IN_PROMPT=10
CONTEXT_VERIFIER_ENABLED=true
CONTEXT_ALLOW_TAVILY_FALLBACK=true
AUTHORITATIVE_ANCHOR_MAX_AGE_HOURS=12
STALE_STATUS_NOTE_COOLDOWN_SEC=86400
BRIEF_PACK_COMPILE_TICK_SEC=60
BRIEF_PACK_MAX_AGE_SEC=5400
BRIEF_PACK_RETENTION_COUNT=120
BRIEF_PACK_MAX_STREAM_DELTAS=10
BRIEF_PACK_MAX_PRIOR_POSTS=6
WRITER_PIPELINE_V2=true
RESEARCHER_CONTRACT_PATH=/config/researcher_contract.yaml
RESEARCHER_TEMPLATES_PATH=/config/researcher_templates.yaml
RESEARCHER_EDITORIAL_BRIEF_PATH=/config/editorial_brief.md
RESEARCHER_CURRENT_PICTURE_BRIEF_PATH=/config/current_picture_brief.md
BRIEFING_PACK_ROOT=/memory/briefing_packs

# Observatory persistence (SQLite on /memory; Redis only for pubsub+sequence)
OBSERVATORY_SQLITE_LIMIT=5000
OBSERVATORY_SEQ_KEY=observatory:seq
OBSERVATORY_PREVIEW_LEN=220

# Deprecated compatibility vars (ignored by new storage path)
OBSERVATORY_HISTORY_KEY=observatory:events
OBSERVATORY_HISTORY_LIMIT=500
